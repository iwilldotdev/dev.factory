{
  "schema": "profile.v1",
  "name": "zeta",
  "role": [
    "tickets",
    "scm",
    "design"
  ],
  "refs": {
    "ticket_key": "(?P<key>ZED-\\d+)",
    "ticket_url": "https://zeta\\.example/t/(?P<key>ZED-\\d+)",
    "change_url": "https://code\\.zeta\\.example/(?P<project>[^/]+/[^/]+)/pr/(?P<number>\\d+)"
  },
  "hints": {
    "ticket": "zeta fetch ticket {key} > {raw_path}",
    "change": "zeta fetch pr {scm_project}#{number} > {raw_path}",
    "pipeline": "zeta fetch run {id} > {raw_path}",
    "design_frame": "zeta fetch frame {id} > {raw_path}",
    "design_image": "zeta fetch png {id} > {raw_path}"
  },
  "kinds": {
    "ticket": {
      "ext": "json",
      "map": {
        "key": {
          "path": "data.issue.ref"
        },
        "title": {
          "path": "data.issue.fields[?k==title][0].v"
        },
        "type": {
          "path": "data.issue.fields[?k==issuetype][0].v"
        },
        "is_bug": {
          "in": [
            {
              "path": "data.issue.fields[?k==issuetype][0].v"
            },
            [
              "Defect",
              "Incident"
            ]
          ]
        },
        "status": {
          "path": "data.issue.fields[?k==status][0].v"
        },
        "description_md": {
          "coalesce": [
            {
              "text_from_tree": {
                "of": {
                  "path": "data.issue.doc"
                },
                "config": {
                  "type_key": "t",
                  "text_node": "txt",
                  "text_key": "s",
                  "children_key": "c",
                  "block": {
                    "paragraph": "para",
                    "heading": "h",
                    "ordered_list": "ol",
                    "list_item": "li",
                    "code_block": "code"
                  },
                  "level_key": "a.level",
                  "marks_key": "m",
                  "marks": {
                    "b": "**",
                    "i": "_"
                  },
                  "link": {
                    "type": "a",
                    "url_key": "href"
                  },
                  "unknown_node": "descend"
                }
              }
            },
            {
              "lit": ""
            }
          ]
        },
        "labels": {
          "each": {
            "over": {
              "path": "data.issue.fields[?k==labels].v"
            },
            "map": {
              "path": "@"
            },
            "flatten": true
          }
        },
        "links": {
          "each": {
            "over": {
              "path": "data.issue.links"
            },
            "map": {
              "object": {
                "kind": {
                  "path": "@.rel"
                },
                "key": {
                  "path": "@.ref"
                },
                "url": {
                  "path": "@.href"
                }
              }
            }
          }
        },
        "comments": {
          "each": {
            "over": {
              "path": "data.issue.comments"
            },
            "map": {
              "object": {
                "id": {
                  "concat": [
                    {
                      "path": "@.cid"
                    }
                  ]
                },
                "author": {
                  "path": "@.who"
                },
                "created": {
                  "date": {
                    "of": {
                      "path": "@.at"
                    },
                    "formats": [
                      "epoch_s",
                      "iso"
                    ]
                  }
                },
                "body_md": {
                  "html_to_md": {
                    "path": "@.html"
                  }
                }
              }
            }
          }
        }
      }
    },
    "change": {
      "ext": "json",
      "map": {
        "repo": {
          "path": "$ctx.repo"
        },
        "number": {
          "path": "pr.num"
        },
        "url": {
          "path": "pr.url"
        },
        "title": {
          "path": "pr.title"
        },
        "description_md": {
          "coalesce": [
            {
              "path": "pr.body"
            },
            {
              "lit": ""
            }
          ]
        },
        "source_branch": {
          "path": "pr.head.ref"
        },
        "target_branch": {
          "path": "pr.base.ref"
        },
        "head_sha": {
          "path": "pr.head.sha"
        },
        "state": {
          "enum": {
            "of": {
              "path": "pr.state"
            },
            "map": {
              "1": "open",
              "2": "merged",
              "3": "closed"
            }
          }
        },
        "draft": {
          "to_bool": {
            "path": "pr.is_draft"
          }
        },
        "author": {
          "path": "pr.by"
        },
        "approvals": {
          "object": {
            "known": {
              "exists": {
                "path": "votes"
              }
            },
            "by": {
              "each": {
                "over": {
                  "path": "votes"
                },
                "where": {
                  "eq": [
                    {
                      "path": "@.verdict"
                    },
                    {
                      "lit": "approved"
                    }
                  ]
                },
                "map": {
                  "path": "@.user"
                }
              }
            }
          }
        }
      }
    },
    "pipeline": {
      "ext": "json",
      "map": {
        "id": {
          "concat": [
            {
              "path": "run.id"
            }
          ]
        },
        "sha": {
          "path": "run.sha"
        },
        "status": {
          "enum": {
            "of": {
              "path": "run.code"
            },
            "map": {
              "0": "pending",
              "1": "running",
              "2": "success",
              "3": "failed"
            }
          }
        },
        "jobs": {
          "each": {
            "over": {
              "path": "run.steps"
            },
            "map": {
              "object": {
                "id": {
                  "concat": [
                    {
                      "path": "@.id"
                    }
                  ]
                },
                "name": {
                  "path": "@.name"
                },
                "status": {
                  "enum": {
                    "of": {
                      "path": "@.code"
                    },
                    "map": {
                      "0": "pending",
                      "1": "running",
                      "2": "success",
                      "3": "failed"
                    }
                  }
                },
                "allow_failure": {
                  "not": {
                    "path": "@.required"
                  }
                }
              }
            }
          }
        }
      }
    },
    "design_frame": {
      "ext": "json",
      "fidelity": "exact",
      "map": {
        "frame": {
          "object": {
            "id": {
              "path": "frame.key"
            },
            "name": {
              "path": "frame.title"
            }
          }
        },
        "source": {
          "object": {
            "file": {
              "path": "$ctx.file"
            },
            "version": {
              "concat": [
                {
                  "path": "frame.rev"
                }
              ]
            }
          }
        },
        "root": {
          "tree": {
            "root": {
              "path": "frame.tree"
            },
            "children": "c",
            "map": {
              "object": {
                "id": {
                  "path": "@.k"
                },
                "name": {
                  "path": "@.n"
                },
                "type": {
                  "enum": {
                    "of": {
                      "path": "@.t"
                    },
                    "map": {
                      "f": "frame",
                      "t": "text",
                      "g": "group"
                    },
                    "default": "other"
                  }
                },
                "box": {
                  "object": {
                    "x": {
                      "path": "@.r[0]"
                    },
                    "y": {
                      "path": "@.r[1]"
                    },
                    "w": {
                      "path": "@.r[2]"
                    },
                    "h": {
                      "path": "@.r[3]"
                    }
                  }
                },
                "opacity": {
                  "to_float": {
                    "path": "@.o"
                  }
                },
                "layout": {
                  "object": {
                    "mode": {
                      "enum": {
                        "of": {
                          "path": "@.lay.dir"
                        },
                        "map": {
                          "row": "horizontal",
                          "col": "vertical"
                        }
                      }
                    },
                    "gap": {
                      "path": "@.lay.gap"
                    }
                  }
                },
                "text": {
                  "object": {
                    "characters": {
                      "path": "@.txt"
                    },
                    "font_size": {
                      "path": "@.fs"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "design_image": {
      "ext": "png"
    }
  },
  "cli_write_patterns": [],
  "mcp_read_allow": [
    "*_peek"
  ],
  "save_args": []
}
